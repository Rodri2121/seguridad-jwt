  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenUser",
      "value": ""
    },
    {
      "key": "tokenModificado",
      "value": ""
    },
    {
      "key": "categoriaCreada",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Autenticación",
      "item": [
        {
          "name": "1. GET saludo público – sin token → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publico/saludo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "publico",
                "saludo"
              ]
            },
            "description": "Ruta /api/publico/** declarada con permitAll(): no requiere autenticación.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "2a. Login admin → 200 + JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().token;\npm.test(\"Devuelve token\", () => pm.expect(t).to.be.a(\"string\"));\npm.collectionVariables.set(\"tokenAdmin\", t);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Credenciales válidas de admin: se emite un JWT firmado (HS256) que vence en 30 minutos. Se guarda en tokenAdmin.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2b. Login operador → 200 + JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().token;\npm.test(\"Devuelve token\", () => pm.expect(t).to.be.a(\"string\"));\npm.collectionVariables.set(\"tokenUser\", t);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Credenciales válidas de operador: se emite un JWT firmado (HS256) que vence en 30 minutos. Se guarda en tokenUser.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"operador\",\n  \"password\": \"Operador123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3. Login contraseña incorrecta → 401",
