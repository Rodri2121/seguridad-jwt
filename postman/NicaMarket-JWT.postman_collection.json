                  "key": "token",
                  "value": "{{tokenUser}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Aceite 1 L\",\n  \"precio\": 62.50,\n  \"stock\": 40,\n  \"categoriaId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7. GET productos – token modificado → 401",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Altera un carácter de la firma del token USER para invalidarlo.",
                  "const t = pm.collectionVariables.get('tokenUser') || '';",
                  "const ult = t.slice(-1) === 'A' ? 'B' : 'A';",
                  "pm.collectionVariables.set('tokenModificado', t.slice(0, -1) + ult);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Se cambia un carácter de la firma: JwtDecoder recalcula el HMAC, no coincide y rechaza el token (401).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenModificado}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "8. POST productos – token ADMIN → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
